#!/usr/bin/env bash
if [ -f "/Users/matthewselvam/.open-dispatch/.env" ]; then
  set -o allexport; source "/Users/matthewselvam/.open-dispatch/.env"; set +o allexport
fi
# The wrapper owns the data dir - it wins over any value inside .env.
export OPEN_DISPATCH_DATA="/Users/matthewselvam/.open-dispatch"
cd "dist/build/bundle-prefix/opt/open-dispatch"
exec "dist/build/bundle-prefix/opt/open-dispatch/venv/bin/uvicorn" api.app:app --host "${HOST:-127.0.0.1}" --port "${PORT:-8000}" "$@"
